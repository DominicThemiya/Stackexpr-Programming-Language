grab asm<io>
grab asm<linux64>

// Prints the odd numbers from 1, stopping after 7.
stackexpr odds ( -- )
	0
	while dup 10 < do
		++
		dup 2 mod 0 == if continue end
		dup 7 > if break end
		dup call putI64
	end
	drop
end

stackexpr sign (n: int -- int)
	dup 0 < if
		drop -1
	else
		0 > if 1 else 0 end
	end
end

stackexpr main
	call odds                                         // 1 3 5 7
	-5 call sign call putI64                          // -1
	0 call sign call putI64                           // 0
	9 call sign call putI64                           // 1
	1 2 over call putI64 call putI64 call putI64      // 1 2 1
	1 2 3 rot call putI64 call putI64 call putI64     // 1 3 2
	1 2 nip call putI64                               // 2
	1 2 tuck call putI64 call putI64 call putI64      // 2 1 2
	true false or not ~int call putI64              // 0
	3 5 < 5 3 < xor ~int call putI64                // 1
end
