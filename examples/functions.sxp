grab asm<io>
grab asm<linux64>
grab "shared/mathlib.sxp"

// Stackexprs are real subroutines, so they can recurse.
stackexpr fact (n: int -- int)
	dup 1 <= if drop 1 return end
	dup 1 - call fact *
end

// Locals name values instead of juggling the stack.
stackexpr sum_of_squares (a: int b: int -- int)
	let a b in
		a a * b b * +
	end
end

// A single letter stands for any type; the checker tracks it through calls.
inline stackexpr twice (a -- a a)
	dup
end

stackexpr square (n: int -- int)
	dup *
end

stackexpr main
	10 call fact call putI64              // 3628800
	3 4 call sum_of_squares call putI64   // 25
	7 call twice + call putI64            // 14
	48 18 call gcd call putI64            // 6, from shared/mathlib.sxp
	2 10 call pow call putI64             // 1024
	9 &square execute (int -- int) call putI64   // 81, called through its address
end
