// A freestanding kernel that writes "Hi" to the VGA text screen and halts.
// asm<multiboot> makes it bootable with QEMU or GRUB; see docs/freestanding.md.
//
//   ./build/stackexpr examples/kernel/vga.sxp --freestanding --entry kmain -T lib/multiboot.ld
//   qemu-system-x86_64 -kernel examples/kernel/vga

grab asm<multiboot>

stackexpr vga_put    // char index --   (white on black)
	2 * 0xb8000 +
	swap 0x0f00 or
	swap !16
end

stackexpr main
	72 0 call vga_put    // 'H'
	105 1 call vga_put   // 'i'
end
