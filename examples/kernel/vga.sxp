// A freestanding kernel that writes "Hi" to the VGA text screen and halts.
// asm<multiboot> makes it bootable with QEMU or GRUB; see docs/freestanding.md.
//
//   make run-kernel

grab asm<multiboot>

const VGA 0xb8000 ~ptr     // the text screen: 80x25 cells of (character, colour)
const WHITE_ON_BLACK 0x0f00

stackexpr vga_put (char: int index: int --)
	2 * VGA +
	swap WHITE_ON_BLACK or
	swap !16
end

stackexpr main
	72 0 call vga_put    // 'H'
	105 1 call vga_put   // 'i'
end
